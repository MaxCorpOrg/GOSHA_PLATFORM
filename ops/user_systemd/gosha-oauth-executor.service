[Unit]
Description=GOSHA OAuth executor on local workstation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/GOSHA_PLATFORM
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=%h/GOSHA_PLATFORM
EnvironmentFile=%h/GOSHA_PLATFORM/local_only/oauth_executor.env
ExecStart=/usr/bin/bash %h/GOSHA_PLATFORM/bin/run_local_oauth_executor.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
