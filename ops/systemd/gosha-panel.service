[Unit]
Description=GOSHA panel and self-hosted gateway
After=network-online.target gosha-backend.service gosha-agent-gateway.service
Wants=network-online.target gosha-backend.service gosha-agent-gateway.service

[Service]
Type=simple
WorkingDirectory=/opt/gosha_platform/app/platform
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/gosha_platform/runtime/env/panel.env
ExecStart=/usr/bin/env python3 /opt/gosha_platform/app/platform/gui_panel.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
