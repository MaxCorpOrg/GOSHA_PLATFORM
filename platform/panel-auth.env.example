PANEL_OPERATOR_USER=operator
PANEL_OPERATOR_PASSWORD_FILE=/opt/gosha_platform/runtime/env/panel.password
PANEL_SESSION_TTL_SECONDS=43200
# Опциональный будущий operator edge hub. На этапе presence-only оставлять пустым:
# PUBLIC_EDGE_HUB_URL=
# Необязательная проверка совместимого облачного контура для /agents/<id>/devices:
# XIAOZHI_API_TOKEN_FILE=/etc/ai-robot-xiaozhi.token
# XIAOZHI_STATUS_CACHE_TTL_SECONDS=45
# Настройки совместимого шлюза и серверного узла платформы `Гоша`:
# SELFHOST_XIAOZHI_PUBLIC_HTTP_BASE=https://panel.example.invalid
# SELFHOST_GOSHA_OTA_URL=https://panel.example.invalid/gosha/ota/
# SELFHOST_GOSHA_ACTIVATE_URL=https://panel.example.invalid/gosha/ota/activate
# SELFHOST_XIAOZHI_OTA_URL=https://panel.example.invalid/gosha/ota/
# SELFHOST_XIAOZHI_ACTIVATE_URL=https://panel.example.invalid/gosha/ota/activate
# SELFHOST_XIAOZHI_WS_URL=wss://voice.example.invalid/xiaozhi/v1/
# SELFHOST_XIAOZHI_MCP_ENDPOINT_BASE=wss://voice.example.invalid/mcp/
# SELFHOST_XIAOZHI_PUBLIC_WS_PORT=18080
