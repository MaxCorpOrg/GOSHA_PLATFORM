SELFHOST_XIAOZHI_TZ=Europe/Moscow
SELFHOST_XIAOZHI_WS_BIND=0.0.0.0
SELFHOST_XIAOZHI_WS_PORT=18080
SELFHOST_XIAOZHI_HTTP_BIND=127.0.0.1
SELFHOST_XIAOZHI_HTTP_PORT=18083
SELFHOST_XIAOZHI_WEB_BIND=127.0.0.1
SELFHOST_XIAOZHI_WEB_PORT=18082
SELFHOST_XIAOZHI_DB_USER=root
# Must be generated in the runtime env file; docker compose stays fail-closed while this is empty.
SELFHOST_XIAOZHI_DB_PASSWORD=
SELFHOST_XIAOZHI_REDIS_PASSWORD=
SELFHOST_XIAOZHI_STORAGE_ROOT=/opt/gosha_platform/runtime/app_root/selfhost_xiaozhi/backend
SELFHOST_XIAOZHI_SILERO_MODEL_ID=v5_5_ru
SELFHOST_XIAOZHI_SILERO_DEFAULT_SPEAKER=xenia
SELFHOST_XIAOZHI_SILERO_SAMPLE_RATE=24000
SELFHOST_XIAOZHI_SILERO_DEVICE=cpu
SELFHOST_XIAOZHI_SILERO_CACHE_DIR=/opt/gosha_platform/runtime/app_root/selfhost_xiaozhi/backend/models/silero
