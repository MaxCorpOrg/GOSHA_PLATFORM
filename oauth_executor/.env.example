OAUTH_EXECUTOR_SESSION_SECRET=change-me
GITHUB_OAUTH_CLIENT_ID=change-me
GITHUB_OAUTH_CLIENT_SECRET=change-me
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:18912/auth/github/callback
GITHUB_OAUTH_SCOPE=read:user repo
GITHUB_EXECUTOR_TOKEN=
OAUTH_EXECUTOR_GITHUB_WEBHOOK_SECRET=
OAUTH_EXECUTOR_REVIEWER_LOGINS=reviewer-login1,reviewer-login2
OAUTH_EXECUTOR_ALLOWED_REPOS=MaxCorpOrg/GOSHA_PLATFORM
OAUTH_EXECUTOR_REPO_PATH=/home/max/GOSHA_PLATFORM
OAUTH_EXECUTOR_WORKTREE_ROOT=/home/max/GOSHA_PLATFORM/local_only/oauth_executor_worktrees
OAUTH_EXECUTOR_VALIDATE_COMMAND=bash bin/ci_validate.sh
OAUTH_EXECUTOR_CODEX_COMMAND=/home/max/.local/bin/codex
OAUTH_EXECUTOR_CODEX_MODEL=
OAUTH_EXECUTOR_CODEX_PROFILE=
OAUTH_EXECUTOR_CODEX_TIMEOUT_SECONDS=1800
OAUTH_EXECUTOR_COMMENT_ON_PR=true
OAUTH_EXECUTOR_COOKIE_SECURE=false
OAUTH_EXECUTOR_GIT_AUTHOR_NAME=GOSHA Codex Executor
OAUTH_EXECUTOR_GIT_AUTHOR_EMAIL=codex-executor@local
