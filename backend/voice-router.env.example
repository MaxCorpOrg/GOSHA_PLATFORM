# Stage beside the existing backend. The public voice route remains unchanged.
GOSHA_VOICE_HOST=127.0.0.1
GOSHA_VOICE_PORT=18084
GOSHA_VOICE_LEGACY_URL=ws://127.0.0.1:18080
GOSHA_VOICE_MAX_SESSIONS=4
# Enable only with compatible firmware and installed libspeexdsp1.
GOSHA_VOICE_ENABLE_DUPLEX=0
# Optional protected JSON map keyed by robot_id: access_key + calibration_id.
# GOSHA_VOICE_MOTION_CREDENTIALS=/opt/gosha_platform/runtime/env/voice-motion.json
# OPENAI_API_KEY belongs in the protected providers.env, never here or in profiles.
